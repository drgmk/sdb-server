<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.drgmk.sdb-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SDB_SERVER_ROOT@/bin/run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@SDB_SERVER_ROOT@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@SDB_SERVER_ROOT@/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>@SDB_SERVER_ROOT@/logs/service.log</string>
</dict>
</plist>
