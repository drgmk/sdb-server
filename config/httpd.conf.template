ServerRoot "@SERVER_ROOT@"
PidFile "run/httpd.pid"
DefaultRuntimeDir "@SERVER_ROOT@/run"

Listen @FRONTEND_HOST@:@FRONTEND_PORT@
ServerName @FRONTEND_HOST@:@FRONTEND_PORT@

LoadModule mpm_prefork_module /usr/libexec/apache2/mod_mpm_prefork.so
LoadModule authn_core_module /usr/libexec/apache2/mod_authn_core.so
LoadModule authn_file_module /usr/libexec/apache2/mod_authn_file.so
LoadModule authz_core_module /usr/libexec/apache2/mod_authz_core.so
LoadModule authz_host_module /usr/libexec/apache2/mod_authz_host.so
LoadModule authz_user_module /usr/libexec/apache2/mod_authz_user.so
LoadModule auth_basic_module /usr/libexec/apache2/mod_auth_basic.so
LoadModule headers_module /usr/libexec/apache2/mod_headers.so
LoadModule alias_module /usr/libexec/apache2/mod_alias.so
LoadModule dir_module /usr/libexec/apache2/mod_dir.so
LoadModule proxy_module /usr/libexec/apache2/mod_proxy.so
LoadModule proxy_http_module /usr/libexec/apache2/mod_proxy_http.so
LoadModule log_config_module /usr/libexec/apache2/mod_log_config.so
LoadModule unixd_module /usr/libexec/apache2/mod_unixd.so

ErrorLog "@SERVER_ROOT@/logs/apache-error.log"
LogLevel warn
# The application activity page reads this extended common format. It uses
# paths, status, user agent, and duration, and discards the client address.
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\" %D" activity
CustomLog "@SERVER_ROOT@/logs/apache-access.log" activity

ServerTokens Prod
ServerSignature Off
ProxyRequests Off
ProxyPreserveHost On

# A browser must never be able to choose the identity trusted by sdf.
RequestHeader unset X-SDF-User early

<Location "/auth/login">
    AuthType Basic
    AuthName "sdb samples"
    AuthUserFile "@AUTH_PASSWORD_FILE@"
    Require valid-user
    RequestHeader set X-SDF-User "expr=%{REMOTE_USER}"
</Location>

# Static Herschel/PACS publication generated by tldr_pacs/web/build.py. This
# exclusion must precede the catch-all sdf proxy below.
ProxyPass /herschel !
# A normal Apache redirect exposes the private HTTP listener through the
# public tunnel, so use an origin-relative browser handoff for the bare path.
AliasMatch "^/herschel$" "@SERVER_ROOT@/config/herschel-redirect.html"
ProxyPass /herschel/ !
Alias /herschel/ "@HERSCHEL_ROOT@/"
<Directory "@HERSCHEL_ROOT@">
    Options -Indexes
    AllowOverride None
    DirectoryIndex index.html
    Require all granted
</Directory>

# sdf and sdb documentation generated by bin/build-docs. Keep these aliases
# ahead of the catch-all sdf proxy.
ProxyPass /docs/sdf !
AliasMatch "^/docs/sdf$" "@DOCS_ROOT@/sdf/html/index.html"
Alias /docs/sdf/ "@DOCS_ROOT@/sdf/html/"
<Directory "@DOCS_ROOT@/sdf/html">
    Options -Indexes
    AllowOverride None
    DirectoryIndex index.html
    Require all granted
</Directory>

ProxyPass /docs/sdb !
AliasMatch "^/docs/sdb$" "@DOCS_ROOT@/sdb/html/index.html"
Alias /docs/sdb/ "@DOCS_ROOT@/sdb/html/"
<Directory "@DOCS_ROOT@/sdb/html">
    Options -Indexes
    AllowOverride None
    DirectoryIndex index.html
    Require all granted
</Directory>

ProxyPass /docs !
AliasMatch "^/docs$" "@DOCS_ROOT@/index.html"
Alias /docs/ "@DOCS_ROOT@/"
<Directory "@DOCS_ROOT@">
    Options -Indexes
    AllowOverride None
    DirectoryIndex index.html
    Require all granted
</Directory>

# Keep backend failures useful even when neither Python service can respond.
# ErrorDocument is an internal subrequest, so the browser retains the original
# job URL and the static page can retry it after a brief service interruption.
ProxyPass /service-unavailable.html !
Alias /service-unavailable.html "@SERVER_ROOT@/config/backend-unavailable.html"
<Directory "@SERVER_ROOT@/config">
    Options -Indexes
    AllowOverride None
    <Files "herschel-redirect.html">
        Require all granted
    </Files>
    <Files "backend-unavailable.html">
        Require all granted
    </Files>
</Directory>
ErrorDocument 502 /service-unavailable.html
ErrorDocument 503 /service-unavailable.html
ErrorDocument 504 /service-unavailable.html

ProxyPass        /review/ http://@REVIEW_HOST@:@REVIEW_PORT@/ connectiontimeout=5 timeout=300
ProxyPassReverse /review/ http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPass        /review http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPassReverse /review http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPass        / http://@SDF_HOST@:@SDF_PORT@/ connectiontimeout=5 timeout=300
ProxyPassReverse / http://@SDF_HOST@:@SDF_PORT@/
