ServerRoot "@SERVER_ROOT@"
PidFile "run/httpd.pid"
DefaultRuntimeDir "@SERVER_ROOT@/run"

Listen @FRONTEND_HOST@:@FRONTEND_PORT@
ServerName @FRONTEND_HOST@:@FRONTEND_PORT@

LoadModule mpm_prefork_module /usr/libexec/apache2/mod_mpm_prefork.so
LoadModule authn_core_module /usr/libexec/apache2/mod_authn_core.so
LoadModule authn_file_module /usr/libexec/apache2/mod_authn_file.so
LoadModule authz_core_module /usr/libexec/apache2/mod_authz_core.so
LoadModule authz_host_module /usr/libexec/apache2/mod_authz_host.so
LoadModule authz_user_module /usr/libexec/apache2/mod_authz_user.so
LoadModule auth_basic_module /usr/libexec/apache2/mod_auth_basic.so
LoadModule headers_module /usr/libexec/apache2/mod_headers.so
LoadModule alias_module /usr/libexec/apache2/mod_alias.so
LoadModule dir_module /usr/libexec/apache2/mod_dir.so
LoadModule proxy_module /usr/libexec/apache2/mod_proxy.so
LoadModule proxy_http_module /usr/libexec/apache2/mod_proxy_http.so
LoadModule log_config_module /usr/libexec/apache2/mod_log_config.so
LoadModule unixd_module /usr/libexec/apache2/mod_unixd.so

ErrorLog "@SERVER_ROOT@/logs/apache-error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b" common
CustomLog "@SERVER_ROOT@/logs/apache-access.log" common

ServerTokens Prod
ServerSignature Off
ProxyRequests Off
ProxyPreserveHost On

# A browser must never be able to choose the identity trusted by SDF.
RequestHeader unset X-SDF-User early

<Location "/auth/login">
    AuthType Basic
    AuthName "SDB samples"
    AuthUserFile "@AUTH_PASSWORD_FILE@"
    Require valid-user
    RequestHeader set X-SDF-User "expr=%{REMOTE_USER}"
</Location>

# Static Herschel/PACS publication generated by tldr_pacs/web/build.py. This
# exclusion must precede the catch-all SDF proxy below.
ProxyPass /herschel !
RedirectMatch 301 ^/herschel$ /herschel/
ProxyPass /herschel/ !
Alias /herschel/ "@HERSCHEL_ROOT@/"
<Directory "@HERSCHEL_ROOT@">
    Options -Indexes
    AllowOverride None
    DirectoryIndex index.html
    Require all granted
</Directory>

ProxyPass        /review/ http://@REVIEW_HOST@:@REVIEW_PORT@/ connectiontimeout=5 timeout=300
ProxyPassReverse /review/ http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPass        /review http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPassReverse /review http://@REVIEW_HOST@:@REVIEW_PORT@/
ProxyPass        / http://@SDF_HOST@:@SDF_PORT@/ connectiontimeout=5 timeout=300
ProxyPassReverse / http://@SDF_HOST@:@SDF_PORT@/
