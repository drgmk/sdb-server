# Copy this file to config/server.conf and adjust it for the host.
# Paths may be absolute or use shell parameter expansion such as $HOME.

SDB_ROOT=/path/to/sdb
SDF_ROOT=/path/to/sdf
SDF_EXPORT_ROOT="$SDB_ROOT/rehearsals/multi-sample/export"
SDF_OPERATOR_DATABASE="$SDF_EXPORT_ROOT/sdf-operator.sqlite"

SDF_FITS=/path/to/python-environment/bin/sdf-fits
SDB_CLI=/path/to/python-environment/bin/sdb
SPHINXBUILD=/path/to/python-environment/bin/sphinx-build

SDB_DATABASE="$SDB_ROOT/rehearsals/multi-sample/sdb.sqlite"
SDB_REFERENCE_DATABASE="$SDB_ROOT/sdb-reference.sqlite"
SDB_CACHE_DATABASE="$SDB_ROOT/sdb-cache.sqlite"
SDB_CONFIG="$SDB_ROOT/sdb.toml"

# These defaults keep private state inside the deployment directory. They are
# ignored by Git and must be copied or created separately on each server.
AUTH_PASSWORD_FILE="$SDB_SERVER_ROOT/.htpasswd"
SESSION_SECRET_FILE="$SDB_SERVER_ROOT/session-secret"

# Static publications are generated artifacts rather than repository content.
HERSCHEL_ROOT="$SDB_SERVER_ROOT/www/herschel"
DOCS_ROOT="$SDB_SERVER_ROOT/www/docs"

HTTPD=/usr/sbin/httpd
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8780
SDF_HOST=127.0.0.1
SDF_PORT=8781
SDB_REVIEW_HOST=127.0.0.1
SDB_REVIEW_PORT=8782

# Two workers are conservative on a 16 GB development machine. Four is a
# reasonable starting point when the machine is dedicated to serving sdb.
SDF_FIT_WORKERS=2

# Daily sampler-work retention. Compact fit results remain available after
# their large native MultiNest work files are removed.
SDF_CLEANUP_SUPERSEDED_DAYS=7
SDF_CLEANUP_COMMITTED_DAYS=30
SDF_CLEANUP_INTERRUPTED_DAYS=30

# Calendar dates and event times shown on the admin activity page. This is an
# IANA timezone name; stored timestamps and cutoffs remain UTC.
SDF_ACTIVITY_TIMEZONE=UTC

# Sample acquisition can resolve and update hundreds of targets. The web job
# shows live progress, while this remains a final guard against a stuck child.
SDB_IMPORT_TIMEOUT=1800
SDB_SAMPLE_IMPORT_TIMEOUT=43200

# Daily verified database snapshots. The main and SDF operator databases are
# always included. Put this on another mounted disk for protection against
# loss of the server disk. Reference and cache databases are rebuildable and
# omitted by default.
SDB_BACKUP_ROOT="$SDB_SERVER_ROOT/private/backups"
SDB_BACKUP_KEEP=14
SDB_BACKUP_INCLUDE_REFERENCE=0
SDB_BACKUP_INCLUDE_CACHE=0
SDB_ASSET_ROOT="$SDB_ROOT/rehearsals/multi-sample/assets"
