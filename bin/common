#!/bin/zsh

set -u

SDB_SERVER_ROOT=${0:A:h:h}
config_file=${SDB_SERVER_CONFIG:-$SDB_SERVER_ROOT/config/server.conf}

if [[ ! -r "$config_file" ]]; then
    print -u2 "Missing server configuration: $config_file"
    print -u2 "Copy $SDB_SERVER_ROOT/config/server.conf.example and edit it for this host."
    return 1 2>/dev/null || exit 1
fi

source "$config_file"

# Backup defaults are deliberately local and conservative. Point
# SDB_BACKUP_ROOT at another mounted disk for protection against server-disk
# loss, or replicate this directory with an encrypted backup tool.
: ${SDB_BACKUP_ROOT:="$SDB_SERVER_ROOT/private/backups"}
: ${SDB_BACKUP_KEEP:=14}
: ${SDB_BACKUP_INCLUDE_REFERENCE:=0}
: ${SDB_BACKUP_INCLUDE_CACHE:=0}
: ${SDB_ASSET_ROOT:="$SDB_ROOT/rehearsals/multi-sample/assets"}
: ${SDF_OPERATOR_DATABASE:="$SDF_EXPORT_ROOT/sdf-operator.sqlite"}
: ${SDB_IMPORT_TIMEOUT:=1800}
: ${SDB_SAMPLE_IMPORT_TIMEOUT:=43200}
: ${SDF_ACTIVITY_TIMEZONE:=UTC}
: ${SDF_CLEANUP_SUPERSEDED_DAYS:=7}
: ${SDF_CLEANUP_COMMITTED_DAYS:=30}
: ${SDF_CLEANUP_INTERRUPTED_DAYS:=30}

required_settings=(
    SDB_ROOT SDF_ROOT SDF_EXPORT_ROOT SDF_FITS SDB_CLI SPHINXBUILD
    SDB_DATABASE SDB_REFERENCE_DATABASE SDF_OPERATOR_DATABASE
    SDB_CACHE_DATABASE SDB_CONFIG AUTH_PASSWORD_FILE SESSION_SECRET_FILE
    HERSCHEL_ROOT DOCS_ROOT HTTPD FRONTEND_HOST FRONTEND_PORT SDF_HOST SDF_PORT
    SDB_REVIEW_HOST SDB_REVIEW_PORT SDF_FIT_WORKERS
)

for setting in $required_settings; do
    if [[ -z ${(P)setting:-} ]]; then
        print -u2 "Missing required setting in $config_file: $setting"
        return 1 2>/dev/null || exit 1
    fi
done

if [[ "$SDF_FIT_WORKERS" != <-> ]] || (( SDF_FIT_WORKERS < 1 )); then
    print -u2 "SDF_FIT_WORKERS must be a positive integer"
    return 1 2>/dev/null || exit 1
fi

if [[ "$SDB_IMPORT_TIMEOUT" != <-> ]] || (( SDB_IMPORT_TIMEOUT < 1 )); then
    print -u2 "SDB_IMPORT_TIMEOUT must be a positive integer number of seconds"
    return 1 2>/dev/null || exit 1
fi

if [[ "$SDB_SAMPLE_IMPORT_TIMEOUT" != <-> ]] \
    || (( SDB_SAMPLE_IMPORT_TIMEOUT < 1 )); then
    print -u2 "SDB_SAMPLE_IMPORT_TIMEOUT must be a positive integer number of seconds"
    return 1 2>/dev/null || exit 1
fi

if [[ "$SDB_BACKUP_KEEP" != <-> ]] || (( SDB_BACKUP_KEEP < 1 )); then
    print -u2 "SDB_BACKUP_KEEP must be a positive integer"
    return 1 2>/dev/null || exit 1
fi

for setting in SDF_CLEANUP_SUPERSEDED_DAYS SDF_CLEANUP_COMMITTED_DAYS \
        SDF_CLEANUP_INTERRUPTED_DAYS; do
    if [[ "${(P)setting}" != <-> ]] || (( ${(P)setting} < 1 )); then
        print -u2 "$setting must be a positive integer number of days"
        return 1 2>/dev/null || exit 1
    fi
done

httpd_config="$SDB_SERVER_ROOT/run/httpd.conf"
