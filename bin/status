#!/bin/zsh

set -u

source ${0:A:h}/common

show_process() {
    local label=$1
    local pid_file=$2
    if [[ -s "$pid_file" ]]; then
        local process_pid=$(<"$pid_file")
        if [[ "$process_pid" == <-> ]] && kill -0 "$process_pid" 2>/dev/null; then
            print "$label: running (PID $process_pid)"
            return
        fi
    fi
    print "$label: stopped"
}

show_process "SDF backend" "$SDB_SERVER_ROOT/run/sdf.pid"
show_process "SDB review backend" "$SDB_SERVER_ROOT/run/sdb-review.pid"
show_process "Apache frontend" "$SDB_SERVER_ROOT/run/httpd.pid"

public_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    "http://$FRONTEND_HOST:$FRONTEND_PORT/" 2>/dev/null || true)
samples_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    "http://$FRONTEND_HOST:$FRONTEND_PORT/samples" 2>/dev/null || true)
admin_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    "http://$FRONTEND_HOST:$FRONTEND_PORT/admin" 2>/dev/null || true)
review_status=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    "http://$FRONTEND_HOST:$FRONTEND_PORT/review/" 2>/dev/null || true)
herschel_status=$(curl --silent --location --output /dev/null --write-out '%{http_code}' \
    "http://$FRONTEND_HOST:$FRONTEND_PORT/herschel" 2>/dev/null || true)

print "Public route: ${public_status:-unreachable}"
print "Samples without credentials: ${samples_status:-unreachable} (expected 200)"
print "Admin without credentials: ${admin_status:-unreachable} (expected 303)"
print "Review without credentials: ${review_status:-unreachable} (expected 303)"
print "Herschel publication: ${herschel_status:-unreachable} (expected 200)"
